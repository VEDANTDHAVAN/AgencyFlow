{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,
    "declaration": false,
    "noEmitOnError": true,

    "types": ["node"]
  },

  "include": [
    "src/**/*.ts",
    "generated/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "prisma"
  ]
}